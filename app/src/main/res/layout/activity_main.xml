<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="24dp">

    <!-- Glow background circle -->
    <View
        android:id="@+id/glowCircle"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_glow_circle" />

    <!-- App icon -->
    <ImageView
        android:id="@+id/imgAppIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitCenter" />

    <!-- Main title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgAppIcon"
        android:layout_marginTop="28dp"
        android:text="Computer Network&#10;Devices AR"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitle"
        android:layout_marginTop="12dp"
        android:text="Learn computer network devices through immersive augmented reality and interactive guidance."
        android:textAlignment="center"
        android:textColor="#B7C9E6"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- Info card -->
    <LinearLayout
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSubtitle"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_info_card">

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore and Learn"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="• View 3D devices in AR&#10;• Learn with avatar assistance&#10;• Practice with interactive quizzes"
            android:textColor="#D7E5F6"
            android:textSize="14sp"
            android:lineSpacingExtra="8dp" />
    </LinearLayout>

    <!-- Bottom button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="28dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#6C4CF1"
        app:cornerRadius="18dp"
        app:icon="@android:drawable/ic_media_play"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="#FFFFFF" />

</RelativeLayout>