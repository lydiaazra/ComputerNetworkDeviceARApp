<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E2A"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvQuizTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Quiz Level"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"/>

    <Button
        android:id="@+id/btnEasy"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Easy"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00BCD4"
        android:layout_below="@id/tvQuizTitle"
        android:layout_marginTop="50dp"/>

    <Button
        android:id="@+id/btnIntermediate"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Intermediate"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00BCD4"
        android:layout_below="@id/btnEasy"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnAdvanced"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Advanced"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00BCD4"
        android:layout_below="@id/btnIntermediate"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textColor="#00BCD4"
        style="?android:attr/borderlessButtonStyle"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"/>

</RelativeLayout>