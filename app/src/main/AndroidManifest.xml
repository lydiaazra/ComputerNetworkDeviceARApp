<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.hardware.camera.ar" android:required="true"/>
    <uses-feature android:name="android.hardware.camera" android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComputerNetworkDeviceARApp">

        <!-- ARCore requirement -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required"
            tools:replace="android:value"/>

        <!-- Welcome Screen - App starts here -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Screen -->
        <activity android:name=".LoginActivity"/>

        <!-- Register Screen -->
        <activity android:name=".RegisterActivity"/>

        <!-- Main Menu Screen -->
        <activity android:name=".MainMenuActivity"/>

        <!-- Quiz Level Selection Screen -->
        <activity android:name=".QuizLevelActivity"/>

        <!-- AR Quiz Screen -->
        <activity android:name=".ARQuizActivity"/>

        <!-- Avatar Screen -->
        <activity android:name=".AvatarActivity"/>

        <!-- Result Screen Screen -->
        <activity android:name=".ResultActivity"/>

        <!-- AR Device Screen -->
        <activity android:name=".DeviceDisplay"/>

    </application>

</manifest>