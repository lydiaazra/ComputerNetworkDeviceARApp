<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081120">

    <!--
        ✅ ArFragment handles AR camera, permissions, plane detection automatically.
           Replace the old ArSceneView with this fragment declaration.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/arFragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top info card -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_info_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDeviceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 Select a device"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap a button below to learn about a device."
            android:textColor="#D7E5F6"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

    <!-- Bottom button panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E5081120"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Device selection row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeviceRouter"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Router"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1A4F8A"
                app:cornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeviceSwitch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Switch"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1A4F8A"
                app:cornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

        </LinearLayout>

        <!-- Place + Back row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlaceAvatar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Place Avatar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1E9E49"
                app:cornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#C73D5A"
                app:cornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>