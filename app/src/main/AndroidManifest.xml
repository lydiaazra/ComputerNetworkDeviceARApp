<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera.ar" android:required="true"/>
    <uses-feature android:name="android.hardware.camera" android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.ComputerNetworkDeviceARApp">

        <meta-data
            android:name="com.google.ar.core"
            android:value="required"
            tools:replace="android:value"/>

        <!-- Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false"/>
        <activity android:name=".RegisterActivity" android:exported="false"/>
        <activity android:name=".DashboardActivity" android:exported="false"/>
        <activity android:name=".QuizLevelActivity" android:exported="false"/>
        <activity android:name=".ResultActivity" android:exported="false"/>
        <activity android:name=".DeviceDisplay" android:exported="false"/>

        <!-- Has EditText + keyboard at bottom — adjustResize keeps input visible -->
        <activity
            android:name=".CombinedARActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".ChatHistoryActivity" android:exported="false"/>

        <activity
            android:name=".ARQuizActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".CameraARActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".DeviceSelectActivity"
            android:exported="false"/>

        <activity
            android:name=".NetworkLabActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".DeviceDemoSelectActivity"
            android:exported="false"/>

    </application>

</manifest>