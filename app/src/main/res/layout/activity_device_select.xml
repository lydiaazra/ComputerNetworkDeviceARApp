<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a Device"
            android:textColor="#8FA5C3"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap a device to view it in AR"
            android:textColor="#8FA5C3"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- Router -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRouter"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="🔀"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Router"
                        android:textColor="#8FA5C3"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connects networks • OSI Layer 3"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Switch -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSwitch"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="🔌"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Switch"
                        android:textColor="#8FA5C3"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connects LAN devices • OSI Layer 2"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hub -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHub"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="📡"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hub"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broadcasts to all ports • OSI Layer 1"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Firewall -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFirewall"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="🛡️"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Firewall"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filters traffic by rules • Multi-layer"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Access Point -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAccessPoint"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="📶"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Access Point"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Extends Wi-Fi wirelessly • OSI Layer 2"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- NIC -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNIC"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="💻"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIC"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connects device to network • OSI Layer 2"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Repeater -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRepeater"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="📡"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repeater"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boosts signal strength • OSI Layer 1"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Gateway -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardGateway"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0E1F3D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="🌐"
                    android:textSize="30sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gateway"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connects different networks • All OSI Layers"
                        android:textColor="#8FA5C3"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8FA5C3"
                    android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#C73D5A"
            app:cornerRadius="14dp"/>

    </LinearLayout>
</ScrollView>