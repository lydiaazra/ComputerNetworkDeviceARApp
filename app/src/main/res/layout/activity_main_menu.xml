<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1026">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Main Menu"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a feature to continue your learning journey"
            android:textAlignment="center"
            android:textColor="#B7C9E6"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- Menu card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111830"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- AR Devices -->
                <LinearLayout
                    android:id="@+id/btnAR"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_menu_item">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="AR Devices"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#8FA5C3"
                        android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.8dp"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:background="#1E2A50"/>

                <!-- Device Demo -->
                <LinearLayout
                    android:id="@+id/btnDeviceDemo"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_menu_item">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Device Demo"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#8FA5C3"
                        android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.8dp"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:background="#1E2A50"/>

                <!-- Interactive Lab -->
                <LinearLayout
                    android:id="@+id/btnNetworkLab"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_menu_item">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Interactive Lab"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#8FA5C3"
                        android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.8dp"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:background="#1E2A50"/>

                <!-- Quiz -->
                <LinearLayout
                    android:id="@+id/btnQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_menu_item">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quiz"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#8FA5C3"
                        android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.8dp"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:background="#1E2A50"/>

                <!-- Avatar Assistant -->
                <LinearLayout
                    android:id="@+id/btnAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_menu_item">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Avatar Assistant"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#8FA5C3"
                        android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.8dp"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:background="#1E2A50"/>

                <!-- AR + Avatar -->
                <LinearLayout
                    android:id="@+id/btnCombinedAR"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_menu_item">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="AR + Avatar"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#8FA5C3"
                        android:textSize="22sp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Logout button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="⎋  Logout"
            android:textAllCaps="false"
            android:textColor="#FF8FA0"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#2A0D14"
            app:cornerRadius="16dp"
            app:strokeColor="#C73D5A"
            app:strokeWidth="1dp"/>

    </LinearLayout>
</FrameLayout>