<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081120">

    <!--
        ✅ FIXED: Replaced io.github.sceneview.ar.ArSceneView
                  with com.google.ar.sceneform.ux.ArFragment
                  (gorisse.thomas.sceneform — Java compatible)
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/arFragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />



    <!-- Top info card -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_info_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDeviceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 Router"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="A router connects multiple networks and forwards data packets."
            android:textColor="#D7E5F6"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Bottom assistant panel -->
    <LinearLayout
        android:id="@+id/assistantPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#F00B1630"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            NOTE: avatarSceneView removed — gorisse.thomas.sceneform does not
            expose a standalone SceneView for non-AR panels.
            Replace with an ImageView showing a static avatar image,
            or use a Lottie animation for a talking avatar effect.
        -->

        <!-- Assistant reply area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvAssistantName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI Assistant"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAssistantStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="#7EDCFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAssistantReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_card"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text="Hello, I can explain this device and answer your networking questions."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Question input -->
        <EditText
            android:id="@+id/etAssistantQuestion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/edit_text_modern_bg"
            android:hint="Ask something about this device..."
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8FA5C3" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlaceDevice"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Place"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1E9E49"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAskAssistant"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Ask"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#4A67F5"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeakReply"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Speak"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#14C7E3"
                app:cornerRadius="14dp" />

        </LinearLayout>

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="130dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#C73D5A"
            app:cornerRadius="14dp" />

    </LinearLayout>

</RelativeLayout>